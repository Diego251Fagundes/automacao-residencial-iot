    {
        "id": "d8677f01f16d16d8",
        "type": "function",
        "z": "40acd8e0d6562256",
        "name": "Formata Dados ",
        "func": "var msgTemp = {payload: msg.payload.temperatura.toFixed(1)};\n\nvar luz = msg.payload.luminosidade;\nvar clrLuz = luz > 2000 ? '#FFB300' : '#8b949e';\nvar msgLuz = {payload: '<span style=\"color:' + clrLuz + '; font-weight:bold; font-size: 16px;\">' + luz + ' ADC</span>'};\n\nvar msgMov = {payload: msg.payload.movimento == 1 \n    ? '<span style=\"background:#da3633;color:white;padding:4px 10px;border-radius:6px;font-weight:bold;font-size:12px;box-shadow: 0 0 10px rgba(218,54,51,0.5);\">DETECTADA</span>' \n    : '<span style=\"background:#238636;color:white;padding:4px 10px;border-radius:6px;font-weight:bold;font-size:12px;\">SEM MOVIMENTO</span>'};\n\nvar msgPortao = {payload: msg.payload.portao_aberto \n    ? '<span style=\"color:#da3633; font-weight:bold; font-size: 16px;\">🔓 ABERTO</span>' \n    : '<span style=\"color:#238636; font-weight:bold; font-size: 16px;\">🔒 FECHADO</span>'};\n\nreturn [msgTemp, msgLuz, msgMov, msgPortao];",
